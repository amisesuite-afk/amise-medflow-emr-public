{
  "extends": "../../tsconfig.base.json",
  "include": ["src/**/*", "../../clinical-content/rules/*.json"],
  "exclude": ["node_modules", "dist"],
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "../..",
    "composite": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "moduleResolution": "bundler",
    "module": "ESNext",
    "lib": ["esnext"],
    "resolveJsonModule": true
  }
}
