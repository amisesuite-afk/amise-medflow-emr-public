{
  "$schema": "../schemas/decision-rules.schema.json",
  "id": "decision-rules",
  "version": "1.0.0",
  "title": "Clinical decision rules as evidence (band likelihood ratios and risks) for the web and iOS Bayesian engines",
  "updated": "2026-09-26",
  "lastReviewed": "unknown",
  "reviewer": "unknown",
  "reference": "Published derivation and validation studies and meta-analyses named per rule. Every value is fromMemory until checked against the source (docs/clinical-validation/changes/evidence-exam.md, Needs sign-off).",
  "evidencePolicy": {
    "recorded": "A rule counts only when the clinician records its value ('Use in decision support' on the web; the stored calculator result on iOS). Values derived automatically from the vital signs are not rule evidence.",
    "diagnostic": "A diagnostic rule's band is an engine feature with the band's likelihood ratio for the target diagnoses. A prognostic rule shows its risk and never changes the differential.",
    "lowBands": "A band with a likelihood ratio below 1 is applied only when the rule's negativeMeaningful is true (LRINEC's low band is not applied).",
    "ruleSupersedesSigns": "While a rule's band is recorded, the rule's component examination signs are neutral for the rule's target diagnoses (they still count for other diagnoses): the rule already contains them.",
    "componentsGrouped": "The rule's component findings from the history, observations and results (paneFeatures) are grouped with the rule for its target: a positive band adds only the part of its likelihood ratio that those findings have not already given (combined effect = the larger of the two); a band below 1 is applied in full, because the engines record findings as present, and a low score is evidence of their absence.",
    "sameTarget": "When two rules for the same target are recorded, supersededBy names the one that is kept (AIR over Alvarado). PERC counts only when no Wells PE above 4 is recorded (appliesWhen).",
    "ios": "iOS applies the same bands from the stored calculator results (DiagnosticDatabase.json 2.2.0 'rule' features) in place of the older fixed score adjustments for those rules; its component-grouping policy covers the examination signs only."
  },
  "rules": [
    {
