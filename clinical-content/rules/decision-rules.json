            "point": 0.2,
            "low": 0.1,
            "high": 0.4
          }
        },
        {
          "id": "mid",
          "label": "5-6: equivocal",
          "min": 5,
          "max": 6,
          "lr": {
            "point": 1.0,
            "low": 0.7,
            "high": 1.5
          }
        },
        {
          "id": "high",
          "label": "7-10: appendicitis likely",
          "min": 7,
          "max": 10,
