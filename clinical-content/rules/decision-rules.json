      ],
      "presentations": [
        "rif-pain",
        "abdominal-pain"
      ],
      "source": "Alvarado A, Ann Emerg Med 1986; Ohle R et al. The Alvarado score for predicting acute appendicitis: a systematic review, BMC Med 2011; McGee, Evidence-Based Physical Diagnosis 5th ed.",
      "quality": "pooled meta-analysis",
