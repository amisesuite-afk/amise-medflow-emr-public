            "low": 2.4,
            "high": 4.4
          }
        }
      ],
      "components": {
        "signs": [
          "mcburney",
          "rebound"
        ],
        "paneFeatures": [
          "pain_migration",
          "anorexia",
          "nausea_vomiting",
          "fever",
          "elevated_wbc"
        ]
      },
      "supersededBy": [
