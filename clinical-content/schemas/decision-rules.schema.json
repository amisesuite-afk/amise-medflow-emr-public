{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amise-medflow.local/clinical-content/decision-rules.schema.json",
  "title": "Clinical decision rules as evidence",
  "description": "clinical-content/rules/decision-rules.json: validated rules with band likelihood ratios (diagnostic) or risks (prognostic), a shared clinical rule file read by the web PANE engine (lib/pane-engine/src/evidence) and iOS (ExamEvidenceCatalogue.swift through SharedClinicalContent; DiagnosticDatabase.json 'rule' features). Checked by scripts/src/exam-evidence-content.test.ts.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "title", "updated", "lastReviewed", "reviewer", "reference", "evidencePolicy", "rules"],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "const": "decision-rules" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "title": { "type": "string" },
    "updated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "lastReviewed": { "type": "string" },
    "reviewer": { "type": "string" },
    "reference": { "type": "string" },
    "evidencePolicy": { "type": "object", "additionalProperties": { "type": "string" } },
    "rules": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/rule" } }
  },
  "$defs": {
    "lr": {
      "type": "object", "additionalProperties": false, "required": ["point"],
      "properties": {
        "point": { "type": "number", "exclusiveMinimum": 0 },
        "low": { "type": "number", "exclusiveMinimum": 0 },
        "high": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "band": {
      "type": "object", "additionalProperties": false, "required": ["id", "label", "lr"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "label": { "type": "string" },
        "min": { "type": "number", "description": "Inclusive lower bound of the recorded value (absent = no bound)." },
        "max": { "type": "number", "description": "Inclusive upper bound (absent = no bound)." },
        "lr": { "oneOf": [{ "$ref": "#/$defs/lr" }, { "type": "null" }] },
        "risk": { "type": "string" }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "kind", "recordKey", "target", "web", "ios", "bands", "components", "supersededBy", "negativeMeaningful", "presentations", "source", "fromMemory", "quality"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "name": { "type": "string" },
        "kind": { "enum": ["diagnostic", "prognostic"] },
        "recordKey": { "type": "string", "description": "encounters.clinical_scores.decisionScores key (web RecordScoreButton)." },
        "target": {
          "type": "object", "additionalProperties": false, "required": ["finding", "pane", "ios"],
          "properties": {
            "finding": { "type": "string" },
            "pane": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9_]+$" } },
            "ios": { "type": "array", "items": { "type": "string" } },
            "pretest": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1 }
          }
        },
        "web": {
          "type": "object", "additionalProperties": false, "required": ["calculator"],
          "properties": { "calculator": { "type": "string", "description": "ScalesTab SCALE_COMPONENTS key." } }
        },
        "ios": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object", "additionalProperties": false, "required": ["param", "activeScore"],
              "properties": {
                "param": { "type": "string", "description": "BayesianDiagnosisEngine.infer parameter / Patient field." },
                "activeScore": { "type": "string", "description": "ActiveScore case name." }
              }
            }
          ]
        },
        "bands": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/band" } },
        "components": {
          "type": "object", "additionalProperties": false, "required": ["signs", "paneFeatures"],
          "properties": {
            "signs": { "type": "array", "items": { "type": "string" } },
            "paneFeatures": { "type": "array", "items": { "type": "string" } }
          }
        },
        "supersededBy": { "type": "array", "items": { "type": "string" } },
        "appliesWhen": {
          "type": "object", "additionalProperties": false, "required": ["rule", "max"],
          "properties": { "rule": { "type": "string" }, "max": { "type": "number" } }
        },
        "negativeMeaningful": { "type": "boolean" },
        "presentations": { "type": "array", "items": { "type": "string" } },
        "source": { "type": "string", "pattern": "(19|20)\\d\\d" },
        "fromMemory": { "type": "boolean" },
        "quality": { "enum": ["pooled meta-analysis", "single study", "expert consensus"] },
        "note": { "type": "string" }
      }
    }
  }
}
