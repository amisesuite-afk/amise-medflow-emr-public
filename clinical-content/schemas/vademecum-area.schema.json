{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amise-medflow.local/clinical-content/vademecum-area.schema.json",
  "title": "Vademecum area (disease-centred content)",
  "description": "clinical-content/vademecum/<area>.json: one presentation area of the disease-centred vademecum. Each disease carries its whole profile: history, examination, score and investigation findings with likelihood ratios (finding ids from findings.json; examination signs and decision rules referenced from clinical-content/rules), formal diagnostic criteria, pathognomonic findings, hard exclusions and the work-up when found incidentally. Phase 1: shadow only (lib/pane-engine/src/vademecum-loop, clinval --engine vademecum). Checked by lint:shared-content and lint:vademecum. Design: docs/VADEMECUM-PLAN.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "title", "updated", "lastReviewed", "reviewer", "status", "area", "setting", "complaints", "related", "diseases"],
  "properties": {
    "$schema": { "type": "string" },
    "$comment": { "type": "string" },
    "id": { "type": "string", "pattern": "^vademecum-[a-z0-9-]+$" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "title": { "type": "string" },
    "updated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "lastReviewed": { "type": "string" },
    "reviewer": { "type": "string" },
    "status": { "enum": ["shadow", "live"] },
    "area": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "setting": { "type": "string" },
    "complaints": {
      "type": "object", "additionalProperties": false, "required": ["frames", "keywords"],
      "description": "Chief complaints that bring up this area: history frames (lib/triage-engine/src/history-frames) and keywords matched at word starts.",
      "properties": {
        "frames": { "type": "array", "items": { "type": "string" } },
        "keywords": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-z0-9 '/-]+$" } }
      }
    },
    "related": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9_]+$" }, "description": "Diseases defined in another area that join this area's candidate set (e.g. pneumonia with abdominal pain)." },
    "diseases": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/disease" } }
  },
  "$defs": {
    "lr": {
      "type": "object", "additionalProperties": false, "required": ["point"],
      "properties": {
        "point": { "type": "number", "exclusiveMinimum": 0 },
        "low": { "type": "number", "exclusiveMinimum": 0 },
        "high": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "link": {
      "type": "object", "additionalProperties": false,
      "required": ["finding", "lrPositive", "lrNegative", "negativeMeaningful", "seed", "seedDetail", "source", "fromMemory"],
      "description": "One finding of a disease with its likelihood ratios. lrPositive / lrNegative are null for a finding that references an examination sign or a decision-rule band: those files hold the ratios.",
      "properties": {
        "finding": { "type": "string" },
        "lrPositive": { "oneOf": [{ "$ref": "#/$defs/lr" }, { "type": "null" }] },
        "lrNegative": { "oneOf": [{ "$ref": "#/$defs/lr" }, { "type": "null" }] },
        "negativeMeaningful": { "type": "boolean", "description": "The documented absence of the finding lowers the disease (lrNegative applies)." },
        "seed": { "enum": ["pane", "ios", "pane+ios", "exam-signs", "decision-rules", "new"], "description": "Where the value came from: converted from the PANE model, from the iOS DiagnosticDatabase.json, both, referenced from a shared rule file, or new content." },
        "seedDetail": { "type": "string", "description": "The original value(s) and the conversion (auditable)." },
        "source": { "type": "string", "description": "The evidence source named for the value." },
        "fromMemory": { "type": "boolean", "description": "Written from memory: not yet checked against the source." }
      }
    },
    "findingsByLevel": {
      "type": "object", "additionalProperties": false, "required": ["history", "exam", "score", "investigation"],
      "properties": {
        "history": { "type": "array", "items": { "$ref": "#/$defs/link" } },
        "exam": { "type": "array", "items": { "$ref": "#/$defs/link" } },
        "score": { "type": "array", "items": { "$ref": "#/$defs/link" } },
        "investigation": { "type": "array", "items": { "$ref": "#/$defs/link" } }
      }
    },
    "criteriaNode": {
      "type": "object", "additionalProperties": false, "required": ["op"],
      "description": "Formal criteria logic: all / any / atLeast k / points (children's weights, total ≥ min) over findings, decision-rule bands (referenced), an external evaluator (an existing deterministic implementation, e.g. the TG18 auto-fill, NG12 screening), or the patient's age / sex.",
      "properties": {
        "op": { "enum": ["all", "any", "atLeast", "points", "finding", "rule", "external", "age", "sex"] },
        "items": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/criteriaNode" } },
        "k": { "type": "integer", "minimum": 1 },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "weight": { "type": "number" },
        "finding": { "type": "string" },
        "state": { "enum": ["present", "absent"] },
        "rule": { "type": "string" },
        "bands": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "evaluator": { "type": "string", "pattern": "^[a-z0-9-]+(:[a-z0-9-]+)?$" },
        "fallback": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/criteriaNode" }, "description": "Used when the external evaluator's result is not supplied (read as 'all of')." },
        "sex": { "enum": ["male", "female"] },
        "label": { "type": "string", "description": "How the item reads in the 'next question' reason (e.g. 'lipase ≥ 3 × ULN')." }
      }
    },
    "criteriaLevel": {
      "type": "object", "additionalProperties": false, "required": ["id", "label", "grade", "when"],
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string" },
        "grade": { "enum": ["definite", "suspected", "referral", "classification"] },
        "when": { "$ref": "#/$defs/criteriaNode" },
        "action": { "type": "string" }
      }
    },
    "criteria": {
      "type": "object", "additionalProperties": false, "required": ["id", "name", "kind", "source", "fromMemory", "levels"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "name": { "type": "string" },
        "kind": { "enum": ["diagnostic", "referral", "classification", "severity"] },
        "source": { "type": "string" },
        "fromMemory": { "type": "boolean" },
        "levels": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/criteriaLevel" } },
        "note": { "type": "string" }
      }
    },
    "pathognomonic": {
      "type": "object", "additionalProperties": false, "required": ["finding", "lrPositive", "definitive", "label", "source", "fromMemory"],
      "description": "A confirmatory or near-confirmatory finding (usually imaging or histology): a very strong likelihood ratio, shown as 'confirmatory finding'. Never an automatic diagnosis.",
      "properties": {
        "finding": { "type": "string" },
        "lrPositive": { "oneOf": [{ "$ref": "#/$defs/lr" }, { "type": "null" }], "description": "null when definitive (policy.definitiveLR applies)." },
        "definitive": { "type": "boolean" },
        "requires": { "type": "array", "items": { "type": "string" }, "description": "Other findings that must also be present." },
        "label": { "type": "string" },
        "source": { "type": "string" },
        "fromMemory": { "type": "boolean" },
        "note": { "type": "string" }
      }
    },
    "exclusion": {
      "type": "object", "additionalProperties": false, "required": ["id", "reason", "source", "fromMemory"],
      "description": "A hard applicability exclusion: the disease drops out, with the reason shown and an override.",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "finding": { "type": "string" },
        "state": { "enum": ["present", "absent"] },
        "sex": { "enum": ["male", "female"] },
        "reason": { "type": "string" },
        "note": { "type": "string" },
        "source": { "type": "string" },
        "fromMemory": { "type": "boolean" }
      }
    },
    "workupStep": {
      "type": "object", "additionalProperties": false, "required": ["id", "label", "source", "fromMemory"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "label": { "type": "string" },
        "when": { "$ref": "#/$defs/criteriaNode" },
        "source": { "type": "string" },
        "fromMemory": { "type": "boolean" }
      }
    },
    "incidentalWorkup": {
      "type": "object", "additionalProperties": false, "required": ["trigger", "steps", "source", "fromMemory"],
      "properties": {
        "trigger": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "classification": { "type": "string", "description": "Id of this disease's classification criteria (e.g. Bosniak, TI-RADS)." },
        "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/workupStep" } },
        "source": { "type": "string" },
        "fromMemory": { "type": "boolean" },
        "note": { "type": "string" }
      }
    },
    "applicability": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "sex": { "enum": ["male", "female"] },
        "ageMin": { "type": "number", "minimum": 0 },
        "ageMax": { "type": "number", "minimum": 0 },
        "pregnancy": { "enum": ["required"] }
      }
    },
    "disease": {
      "type": "object", "additionalProperties": false,
      "required": [
        "id", "label", "icd10", "pane", "ios", "prevalenceTier", "cantMiss", "urgency", "course", "seedFromComplaint",
        "findings", "criteria", "pathognomonic", "exclusions", "workupWhenIncidental", "source", "signOff"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_]+$", "description": "The PANE disease id where one exists." },
        "label": { "type": "string" },
        "icd10": { "type": "string", "pattern": "^[A-Z][0-9][0-9A-Z](\\.[0-9A-Z]{1,4})?$" },
        "pane": { "oneOf": [{ "type": "string", "pattern": "^[a-z0-9_]+$" }, { "type": "null" }] },
        "ios": { "oneOf": [{ "type": "string" }, { "type": "null" }], "description": "The iOS DiagnosticDatabase.json candidate name it corresponds to." },
        "prevalenceTier": { "enum": ["common", "frequent", "uncommon", "rare", "veryRare"] },
        "cantMiss": { "type": "boolean" },
        "urgency": { "enum": ["routine", "soon", "urgent", "emergency"] },
        "course": { "enum": ["acute", "subacute", "chronic", "any"] },
        "applicability": { "$ref": "#/$defs/applicability" },
        "seedFromComplaint": { "type": "boolean", "description": "false: offered only from an entry-point finding (an incidental finding), never from the chief complaint alone." },
        "decision": { "type": "string", "description": "lib/pane-engine/src/decision/treatment-decisions.json decision id whose test / treat thresholds stop the loop." },
        "findings": { "$ref": "#/$defs/findingsByLevel" },
        "criteria": { "type": "array", "items": { "$ref": "#/$defs/criteria" } },
        "pathognomonic": { "type": "array", "items": { "$ref": "#/$defs/pathognomonic" } },
        "exclusions": { "type": "array", "items": { "$ref": "#/$defs/exclusion" } },
        "workupWhenIncidental": { "oneOf": [{ "$ref": "#/$defs/incidentalWorkup" }, { "type": "null" }] },
        "source": { "type": "string" },
        "signOff": { "enum": ["pending", "signed"] },
        "note": { "type": "string" }
      }
    }
  }
}
