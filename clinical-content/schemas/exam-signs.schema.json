{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amise-medflow.local/clinical-content/exam-signs.schema.json",
  "title": "Evidence-based examination signs",
  "description": "clinical-content/rules/exam-signs.json: bedside signs with likelihood ratios, a shared clinical rule file read by the web PANE engine (lib/pane-engine/src/evidence) and iOS (ExamEvidenceCatalogue.swift through SharedClinicalContent; DiagnosticDatabase.json 'sign' features). Checked by lint:shared-content and scripts/src/exam-evidence-content.test.ts.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "title", "updated", "lastReviewed", "reviewer", "reference", "conversion", "engineModes", "absencePolicy", "frames", "presentations", "targetGroups", "signs"],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "const": "exam-signs" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "title": { "type": "string" },
    "updated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "lastReviewed": { "type": "string", "description": "\"unknown\" until a named clinician reviews the content (never a date without that review)." },
    "reviewer": { "type": "string" },
    "reference": { "type": "string" },
    "conversion": { "type": "string" },
    "engineModes": {
      "type": "object", "additionalProperties": false, "required": ["lr", "twin", "none"],
      "properties": { "lr": { "type": "string" }, "twin": { "type": "string" }, "none": { "type": "string" } }
    },
    "absencePolicy": { "type": "string" },
    "frames": {
      "type": "object",
      "description": "The complaint's history frame (lib/triage-engine/src/history-frames classifyComplaint, the classifier the history step uses; iOS HistoryFrameClassifier) → the Exam step: the iOS primary examination region (ExamRegion.swift), the web examination systems to show (ExaminationTab) and the presentation tags whose signs and rules are offered. Keyed by frame id (\"pain.chest\", \"lump.hernia\") or symptom type (\"cough\"); scripts/src/exam-evidence-content.test.ts fails when a history frame has no entry.",
      "propertyNames": { "pattern": "^[a-z_]+(\\.[a-z_]+)?$" },
      "additionalProperties": {
        "type": "object", "additionalProperties": false, "required": ["region", "systems", "presentations"],
        "properties": {
          "region": { "enum": ["abdomen", "chest-cardiac", "chest-respiratory", "neck", "breast", "groin", "oropharynx", "perianal", "skin", "wound", "lump", "scrotal", "urological", "neuro", "limb", "back", "general"] },
          "systems": { "type": "array", "items": { "enum": ["general", "respiratory", "cardiovascular", "abdomen", "perineal", "anal", "genital", "neurological", "extremities", "breast", "wound", "skin"] } },
          "presentations": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "presentations": {
      "type": "object",
      "description": "Presentation tags. A tag is offered when the complaint's history frame lists it (\"frames\"), or when one of its keywords (lower case, matched at word starts in the complaint, history and symptom chips) names a site, mechanism or condition the frame does not distinguish (right upper quadrant, an ankle injury, a sore throat).",
      "additionalProperties": {
        "type": "object", "additionalProperties": false, "required": ["label", "keywords"],
        "properties": {
          "label": { "type": "string" },
          "keywords": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-z0-9 '/-]+$" } }
        }
      }
    },
    "targetGroups": {
      "type": "object",
      "description": "What a sign is evidence for. pane: lib/pane-engine disease ids; ios: lower-case fragments of DiagnosticDatabase candidate names.",
      "additionalProperties": {
        "type": "object", "additionalProperties": false, "required": ["label", "pane", "ios"],
        "properties": {
          "label": { "type": "string" },
          "pane": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9_]+$" } },
          "ios": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "signs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sign" } }
  },
  "$defs": {
    "lr": {
      "type": "object", "additionalProperties": false, "required": ["point"],
      "properties": {
        "point": { "type": "number", "exclusiveMinimum": 0 },
        "low": { "type": "number", "exclusiveMinimum": 0 },
        "high": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "target": {
      "type": "object", "additionalProperties": false, "required": ["group"],
      "properties": {
        "group": { "type": "string" },
        "paneFeature": { "type": "string", "description": "Finding-level sign: the PANE finding feature it detects (e.g. ascites, dehydration). The engine marginalises over the finding." },
        "pretest": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1, "description": "Reference pre-test probability of the finding, for the 'moved from → to' display only." }
      }
    },
    "sign": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "synonyms", "system", "region", "elicit", "presentations", "target", "lrPositive", "lrNegative", "negativeMeaningful", "engine", "supersedes", "source", "fromMemory", "quality"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "name": { "type": "string" },
        "synonyms": { "type": "array", "items": { "type": "string" } },
        "system": { "enum": ["abdomen", "hernia", "chest", "cardiac", "vascular", "breast", "thyroid", "neuro", "liver", "dehydration", "sepsis", "rectal", "lymph-nodes"] },
        "region": { "type": "string" },
        "elicit": { "type": "string", "description": "How to elicit it, one line." },
        "presentations": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "target": { "$ref": "#/$defs/target" },
        "alsoTargets": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false, "required": ["group", "lrPositive"],
            "properties": { "group": { "type": "string" }, "lrPositive": { "$ref": "#/$defs/lr" } }
          }
        },
        "lrPositive": { "oneOf": [{ "$ref": "#/$defs/lr" }, { "type": "null" }] },
        "lrNegative": { "oneOf": [{ "$ref": "#/$defs/lr" }, { "type": "null" }] },
        "negativeMeaningful": { "type": "boolean", "description": "Whether an examined-and-absent sign updates the engines (false when LR- is near 1)." },
        "engine": { "enum": ["lr", "twin", "none"] },
        "supersedes": { "type": "array", "items": { "type": "string" }, "description": "PANE free-text twin features dropped when the chip is recorded (engine lr)." },
        "twins": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "present": { "type": "array", "items": { "type": "string" } },
            "absent": { "type": "array", "items": { "type": "string" } }
          }
        },
        "applicability": {
          "type": "object", "additionalProperties": false,
          "properties": { "ageMin": { "type": "number" }, "ageMax": { "type": "number" } }
        },
        "source": { "type": "string", "pattern": "(19|20)\\d\\d" },
        "fromMemory": { "type": "boolean", "description": "true until the numbers are checked against the named source." },
        "quality": { "enum": ["pooled meta-analysis", "single study", "expert consensus"] },
        "note": { "type": "string" }
      }
    }
  }
}
