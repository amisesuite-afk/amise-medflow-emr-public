  "guideline": [
    {
      "id": "wses-diverticulitis-2020",
      "name": "WSES guidelines — acute colonic diverticulitis in the emergency setting (2020 update)",
      "year": 2020,
      "section": "CT staging (WSES CT classification); uncomplicated: antibiotics not always needed in immunocompetent patients, outpatient care; abscess >4–5 cm: percutaneous drainage + antibiotics; generalised peritonitis: emergency surgery (Hartmann's or resection with primary anastomosis ± stoma); immunocompromised: high risk, antibiotics, low threshold for surgery",
      "citation": "Sartelli M, Weber DG, Kluger Y, et al. 2020 update of the WSES guidelines for the management of acute colonic diverticulitis in the emergency setting. World J Emerg Surg. 2020;15:32.",
      "verified": false
    },
    {
      "id": "hinchey-mod-1999",
      "name": "Modified Hinchey classification",
      "year": 1999,
      "section": "0 mild; Ia confined pericolic inflammation/phlegmon; Ib pericolic or mesocolic abscess; II pelvic/distant abscess; III generalised purulent peritonitis; IV faecal peritonitis",
      "citation": "Wasvary H, Turfah F, Kadro O, Beauregard W. Same hospitalization resection for acute diverticulitis. Am Surg. 1999;65:632–5.",
      "verified": false
    },
    {
      "id": "ssc-2021",
      "name": "Surviving Sepsis Campaign — international guidelines for sepsis and septic shock 2021",
      "year": 2021,
      "section": "Screening (do not use qSOFA alone), antibiotics within 1 h of shock, blood cultures, lactate, 30 mL/kg crystalloid for hypoperfusion, vasopressors, source control",
      "citation": "Evans L, Rhodes A, Alhazzani W, et al. Surviving Sepsis Campaign: international guidelines for management of sepsis and septic shock 2021. Crit Care Med. 2021;49:e1063–e1143.",
      "verified": false
    }
  ],
