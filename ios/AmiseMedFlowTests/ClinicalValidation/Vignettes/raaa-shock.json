  "guideline": [
    {
      "id": "esvs-aaa-2024",
      "name": "ESVS 2024 clinical practice guidelines — abdominal aorto-iliac artery aneurysms",
      "year": 2024,
      "section": "Suspected rupture: immediate vascular surgical assessment and transfer to a vascular centre; permissive hypotension in the conscious patient; CT angiography only if the patient is stable enough; EVAR preferred when anatomy is suitable. Consider AAA in older patients presenting with flank/back pain mimicking renal colic",
      "citation": "Wanhainen A, Van Herzeele I, Bastos Goncalves F, et al. European Society for Vascular Surgery (ESVS) 2024 Clinical Practice Guidelines on the Management of Abdominal Aorto-Iliac Artery Aneurysms. Eur J Vasc Endovasc Surg. 2024;67:192–331.",
      "verified": false
    },
    {
      "id": "nice-ng156",
      "name": "NICE NG156 — Abdominal aortic aneurysm: diagnosis and management",
      "year": 2020,
      "section": "Suspected symptomatic or ruptured AAA: immediate discussion with the regional vascular service; imaging should not delay transfer of an unstable patient; permissive hypotension",
      "citation": "National Institute for Health and Care Excellence. Abdominal aortic aneurysm: diagnosis and management (NG156). London: NICE; 2020.",
      "verified": false
    }
  ],
  "rationale": "Base ruptured AAA with classic triad and shock. ICD-10 I71.3 (ruptured AAA) is the correct code and tests the ICD → protocol route (the protocol is registered under I71.9). Expectations: emergency, shock alarm, immediate repair, permissive hypotension and no large boluses.",
