  "guideline": [
    {
      "id": "nice-ng148",
      "verified": false,
      "name": "NICE NG148 - Acute kidney injury: prevention, detection and management",
      "year": 2019,
      "section": "Detect AKI with KDIGO criteria (creatinine rise >=26 micromol/L in 48 h or >=50% in 7 days, or urine output <0.5 mL/kg/h for >6 h); assess volume status and give IV fluids for hypovolaemia; stop or withhold nephrotoxic and AKI-risk medicines (NSAIDs, ACE inhibitors/ARBs, diuretics; review metformin)",
      "citation": "National Institute for Health and Care Excellence. NG148. London: NICE; 2019 (updated 2023)."
    }
  ],
  "rationale": "Base GI-infection case: the danger in the elderly is not the diarrhoea but the AKI from hypovolaemia on ACE inhibitor/diuretic/metformin. Creatinine rise 88 -> 212 (2.4x) = KDIGO stage 2.",
