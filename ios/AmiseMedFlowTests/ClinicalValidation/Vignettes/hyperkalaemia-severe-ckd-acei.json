  "guideline": [
    {
      "id": "ukka-hyperk-2023",
      "name": "UK Kidney Association — Clinical practice guideline: treatment of acute hyperkalaemia in adults",
      "year": 2023,
      "section": "Severity (mild 5.5–5.9, moderate 6.0–6.4, severe ≥6.5 mmol/L); urgent 12-lead ECG and cardiac monitoring; IV calcium (calcium chloride 10% 10 mL or calcium gluconate 10% 30 mL) for ECG changes; insulin–glucose (10 units soluble insulin with 25 g glucose) with glucose monitoring to prevent hypoglycaemia; nebulised salbutamol as adjunct; stop/withhold drugs that raise potassium; treat the cause; dialysis for refractory hyperkalaemia",
      "citation": "UK Kidney Association. Clinical Practice Guidelines: Treatment of Acute Hyperkalaemia in Adults. UKKA; 2023 (update of the 2020 Renal Association guideline).",
      "verified": false
    }
  ],
  "rationale": "UKKA 2023: ECG, IV calcium for ECG changes, insulin–glucose with glucose monitoring, salbutamol, stop contributing drugs, renal input.",
