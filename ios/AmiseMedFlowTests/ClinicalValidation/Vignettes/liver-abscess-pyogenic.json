  "guideline": [
    {
      "id": "review-liver-abscess-2015",
      "name": "Hepatic abscess: diagnosis and management (narrative review — no formal international guideline exists)",
      "year": 2015,
      "section": "Pyogenic abscess: blood cultures, CT, antibiotics for 4–6 weeks, percutaneous drainage/aspiration for larger abscesses, look for a biliary or colonic source; multiple cholangitic abscesses: treat the biliary obstruction",
      "citation": "Lardière-Deguelte S, Ragot E, Amroun K, et al. J Visc Surg. 2015;152:231–243.",
      "verified": false
    },
    {
      "id": "idsa-2010-ciai",
      "name": "SIS/IDSA guidelines — complicated intra-abdominal infection",
      "year": 2010,
      "section": "Source control (percutaneous drainage preferred when feasible) plus antimicrobial therapy; blood cultures",
      "citation": "Solomkin JS, Mazuski JE, Bradley JS, et al. Clin Infect Dis. 2010;50:133–164.",
      "verified": false
    },
    {
      "id": "ssc-2021",
      "name": "Surviving Sepsis Campaign guidelines 2021",
      "year": 2021,
      "section": "Blood cultures before antimicrobials; antimicrobials within 1 h for shock; source control; noradrenaline first-line vasopressor",
      "citation": "Evans L, Rhodes A, Alhazzani W, et al. Crit Care Med. 2021;49:e1063–e1143.",
      "verified": false
    },
    {
      "id": "review-amoebiasis-2003",
      "name": "Amebiasis (narrative review — no formal international guideline exists)",
      "year": 2003,
      "section": "Amoebic liver abscess: serology; metronidazole (or tinidazole) followed by a luminal agent (paromomycin, diloxanide furoate) to eradicate intestinal carriage; aspiration only for no response, left-lobe or imminent rupture",
      "citation": "Haque R, Huston CD, Hughes M, Houpt E, Petri WA Jr. N Engl J Med. 2003;348:1565–1573.",
      "verified": false
    }
  ],
  "rationale": "Base case for liver abscess. There is no formal international guideline; expectations follow the SIS/IDSA source-control principles and review consensus: blood cultures, antibiotics, image-guided drainage for a large multiloculated abscess, a 4–6-week course, and a search for the source. Amoebic serology reflects Caribbean practice.",
  "authoring": {
    "author": "Claude (HPB cluster)",
    "date": "2026-09-25",
    "notes": "Expectations and citations need surgeon sign-off (reviewedBy). iOS outcomes not yet observed (unverified: ios) — triage after the first CI run."
  }
