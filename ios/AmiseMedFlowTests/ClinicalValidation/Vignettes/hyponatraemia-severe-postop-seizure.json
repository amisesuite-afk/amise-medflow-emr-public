  "guideline": [
    {
      "id": "eur-hypona-2014",
      "name": "European clinical practice guideline on diagnosis and treatment of hyponatraemia (ESE/ESICM/ERBP)",
      "year": 2014,
      "section": "Severe symptoms (seizure, vomiting, reduced consciousness): 150 mL 3% hypertonic saline over 20 min, repeated (up to twice) checking sodium, target +5 mmol/L; moderately severe symptoms: single 150 mL 3% infusion; limit the rise to 10 mmol/L in the first 24 h and 8 mmol/L in each subsequent 24 h; hypovolaemic hyponatraemia: restore volume with 0.9% saline or balanced crystalloid; SIADH: fluid restriction first line; stop contributing drugs",
      "citation": "Spasovski G, Vanholder R, Allolio B, et al. Clinical practice guideline on diagnosis and treatment of hyponatraemia. Eur J Endocrinol. 2014;170:G1–47.",
      "verified": false
    }
  ],
