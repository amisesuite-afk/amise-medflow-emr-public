  "guideline": [
    {
      "id": "jbds-dka-2023",
      "name": "JBDS-IP — The management of diabetic ketoacidosis in adults (current revision)",
      "year": 2023,
      "section": "Diagnosis (ketonaemia ≥3.0 mmol/L or ketonuria ≥2+, bicarbonate <15 mmol/L and/or venous pH <7.3, glucose >11 mmol/L or known diabetes); fixed-rate IV insulin infusion (0.1 units/kg/h); 0.9% sodium chloride; potassium replacement by serum level; continue long-acting insulin; add 10% glucose when glucose falls below 14 mmol/L; euglycaemic DKA with SGLT2 inhibitors (glucose may be normal)",
      "citation": "Dhatariya KK; Joint British Diabetes Societies for Inpatient Care. The management of diabetic ketoacidosis in adults — an updated guideline from the Joint British Diabetes Society for Inpatient Care. Diabet Med. 2022;39:e14788 (JBDS-IP 02; edition/year to be confirmed against the current JBDS document).",
      "verified": false
    },
    {
      "id": "ada-hhc-2024",
      "name": "Hyperglycaemic crises in adults with diabetes — consensus report (ADA/EASD/JBDS/AACE/DTS)",
      "year": 2024,
      "section": "DKA diagnosis (glucose or prior diabetes, ketones, pH/bicarbonate) including euglycaemic DKA with SGLT2 inhibitors; HHS diagnosis (marked hyperglycaemia, hyperosmolality, no significant ketoacidosis); IV fluids, insulin, potassium; search for precipitant",
      "citation": "Umpierrez GE, Davis GM, ElSayed NA, et al. Hyperglycemic crises in adults with diabetes: a consensus report. Diabetes Care. 2024;47:1257–75.",
      "verified": false
    },
    {
      "id": "cpoc-diabetes-2022",
      "name": "CPOC — Guideline for perioperative care for people with diabetes mellitus undergoing elective and emergency surgery",
      "year": 2022,
      "section": "SGLT2 inhibitors: omit before surgery and restart only when eating and drinking normally; check blood ketones in unwell patients on SGLT2 inhibitors even when glucose is normal (euglycaemic DKA)",
      "citation": "Centre for Perioperative Care. Guideline for perioperative care for people with diabetes mellitus undergoing elective and emergency surgery. London: CPOC; 2021 (updated 2022).",
      "verified": false
    }
  ],
  "rationale": "Euglycaemic DKA is a known SGLT2-inhibitor complication after surgery. The diagnosis rests on ketones; treatment adds glucose to the insulin infusion from the start and stops the SGLT2 inhibitor (JBDS, ADA 2024, CPOC).",
