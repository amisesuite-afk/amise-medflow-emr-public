  "guideline": [
    {
      "id": "wses-2019",
      "name": "WSES guidelines — esophageal emergencies (perforation, caustic ingestion, foreign bodies)",
      "year": 2019,
      "section": "Oesophageal perforation: CT with oral water-soluble contrast is the investigation of choice; nil by mouth, broad-spectrum antibiotics and antifungals, drainage; primary repair when early and feasible, or endoscopic/stent therapy in selected cases; treatment within 24 h lowers mortality",
      "citation": "Chirica M, Kelly MD, Siboni S, et al. World J Emerg Surg. 2019;14:26.",
      "verified": false
    },
    {
      "id": "esc-acs-2023",
      "name": "2023 ESC Guidelines for the management of acute coronary syndromes",
      "year": 2023,
      "section": "Chest pain: 12-lead ECG within 10 minutes; high-sensitivity troponin",
      "citation": "Byrne RA, Rossello X, Coughlan JJ, et al. Eur Heart J. 2023;44:3720–3826.",
      "verified": false
    }
  ],
  "rationale": "Base Boerhaave case with Mackler's triad and radiological confirmation. Must-not-miss: mortality rises steeply with delay beyond 24 h. The engines must rank perforation, escalate, and plan CT with oral contrast, NBM, antibiotics and surgery.",
