  "guideline": [
    {
      "id": "vather-poi-2013",
      "name": "Definition of postoperative ileus (systematic review and consensus)",
      "year": 2013,
      "section": "Prolonged post-operative ileus: two or more of nausea/vomiting, inability to tolerate oral diet over 24 h, absence of flatus over 24 h, distension, radiological confirmation, on or after day 4 without prior resolution",
      "citation": "Vather R, Trivedi S, Bissett I. J Gastrointest Surg. 2013;17:962–72.",
      "verified": false
    },
    {
      "id": "eras-colorectal-2019",
      "name": "ERAS Society guidelines — elective colorectal surgery",
      "year": 2019,
      "section": "Opioid-sparing multimodal analgesia, avoidance of fluid overload, early oral intake, no routine nasogastric tube; prolonged ileus should prompt a search for a cause",
      "citation": "Gustafsson UO, Scott MJ, Hubner M, et al. World J Surg. 2019;43:659–95.",
      "verified": false
    }
  ],
  "rationale": "Base prolonged post-operative ileus. Tests diagnosis, keeping leak/obstruction in view, electrolytes, NG decompression, opioid reduction and CT when not settling.",
