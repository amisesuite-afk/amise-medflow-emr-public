  "guideline": [
    {
      "id": "wses-2020",
      "name": "WSES Jerusalem guidelines — diagnosis and treatment of acute appendicitis (2020 update)",
      "year": 2020,
      "section": "Clinical scores (AIR/AAS over Alvarado), imaging by age/sex/pregnancy, antibiotic-first option, complicated appendicitis (abscess), antibiotic duration",
      "citation": "Di Saverio S, Podda M, De Simone B, et al. Diagnosis and treatment of acute appendicitis: 2020 update of the WSES Jerusalem guidelines. World J Emerg Surg. 2020;15:27.",
      "verified": false
    },
    {
      "id": "ssc-2021",
      "name": "Surviving Sepsis Campaign — international guidelines for sepsis and septic shock 2021",
      "year": 2021,
      "section": "Screening (do not use qSOFA alone), antibiotics within 1 h of shock, blood cultures, lactate, 30 mL/kg crystalloid for hypoperfusion, vasopressors, source control",
      "citation": "Evans L, Rhodes A, Alhazzani W, et al. Surviving Sepsis Campaign: international guidelines for management of sepsis and septic shock 2021. Crit Care Med. 2021;49:e1063–e1143.",
      "verified": false
    },
    {
      "id": "sepsis-3",
      "name": "Third international consensus definitions for sepsis and septic shock (Sepsis-3)",
      "year": 2016,
      "section": "qSOFA: RR ≥22, altered mentation, SBP ≤100",
      "citation": "Singer M, Deutschman CS, Seymour CW, et al. JAMA. 2016;315:801–10.",
      "verified": false
    }
  ],
  "rationale": "Permutation: severity. Generalised peritonitis with sepsis must be an emergency with a sepsis alarm, blood cultures, antibiotics, resuscitation and emergency source control; postoperative antibiotics are indicated here (short course), unlike uncomplicated disease.",
