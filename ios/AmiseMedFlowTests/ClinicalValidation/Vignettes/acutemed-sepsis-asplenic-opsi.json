  "guideline": [
    {
      "id": "bcsh-asplenia-2011",
      "verified": false,
      "name": "BCSH - Review of guidelines for the prevention and treatment of infection in patients with an absent or dysfunctional spleen",
      "year": 2011,
      "section": "Overwhelming post-splenectomy infection: febrile asplenic patients need urgent assessment and immediate empirical antibiotics; patients should carry a standby antibiotic supply and an alert card",
      "citation": "Davies JM, Lewis MPN, Wimperis J, et al. Br J Haematol. 2011;155:308-17."
    },
    {
      "id": "ssc-2021",
      "verified": false,
      "name": "Surviving Sepsis Campaign: international guidelines for management of sepsis and septic shock 2021",
      "year": 2021,
      "section": "Screening: recommend against qSOFA alone compared with SIRS, NEWS or MEWS; antimicrobials within 1 h for possible septic shock or high likelihood of sepsis; blood cultures before antimicrobials; lactate measurement; 30 mL/kg IV crystalloid within 3 h for sepsis-induced hypoperfusion or septic shock; noradrenaline first-line vasopressor, MAP target 65 mmHg",
      "citation": "Evans L, Rhodes A, Alhazzani W, et al. Crit Care Med. 2021;49:e1063-e1143."
    }
  ],
  "rationale": "Surgical permutation: a late complication of our own operation. Fever, shock and purpura in an asplenic patient must be treated immediately; no engine should wait for a source.",
