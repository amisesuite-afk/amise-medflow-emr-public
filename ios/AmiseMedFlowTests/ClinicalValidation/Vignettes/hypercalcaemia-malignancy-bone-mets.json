  "guideline": [
    {
      "id": "sfe-hypercalc-2016",
      "name": "Society for Endocrinology — Emergency management of acute hypercalcaemia in adult patients",
      "year": 2016,
      "section": "Symptomatic or severe hypercalcaemia: IV 0.9% sodium chloride rehydration guided by fluid status, then IV bisphosphonate; measure PTH to separate PTH-dependent from PTH-independent (malignancy) causes; stop calcium, vitamin D and thiazides",
      "citation": "Walsh J, Gittoes N, Selby P; Society for Endocrinology Clinical Committee. Society for Endocrinology endocrine emergency guidance: emergency management of acute hypercalcaemia in adult patients. Endocr Connect. 2016;5:G9–G11.",
      "verified": false
    },
    {
      "id": "endo-hcm-2023",
      "name": "Endocrine Society clinical practice guideline — Treatment of hypercalcemia of malignancy in adults",
      "year": 2023,
      "section": "IV hydration plus an antiresorptive (IV bisphosphonate, preferably zoledronic acid, or denosumab); calcitonin only as short-term adjunct for severe hypercalcaemia; treat the underlying malignancy; adjust bisphosphonate for renal function",
      "citation": "El-Hajj Fuleihan G, Clines GA, Hu MI, et al. Treatment of hypercalcemia of malignancy in adults: an Endocrine Society clinical practice guideline. J Clin Endocrinol Metab. 2023;108:507–528.",
      "verified": false
    }
  ],
  "rationale": "Hypercalcaemia outside parathyroid surgery: IV saline then an antiresorptive; PTH separates malignancy from hyperparathyroidism (SfE 2016, Endocrine Society 2023).",
