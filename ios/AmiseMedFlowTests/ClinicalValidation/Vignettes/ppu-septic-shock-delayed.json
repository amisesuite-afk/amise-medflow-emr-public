  "guideline": [
    {
      "id": "wses-ppu-2020",
      "name": "WSES guidelines — perforated and bleeding peptic ulcer",
      "year": 2020,
      "section": "CT/erect CXR for free air; early source control (laparoscopic or open repair / omental patch); broad-spectrum antibiotics; resuscitation; H. pylori testing and eradication; risk scores (Boey, PULP)",
      "citation": "Tarasconi A, Coccolini F, Biffl WL, et al. Perforated and bleeding peptic ulcer: WSES guidelines. World J Emerg Surg. 2020;15:3.",
      "verified": false
    },
    {
      "id": "ssc-2021",
      "name": "Surviving Sepsis Campaign — international guidelines for sepsis and septic shock 2021",
      "year": 2021,
      "section": "Screening (do not use qSOFA alone), antibiotics within 1 h of shock, blood cultures, lactate, 30 mL/kg crystalloid for hypoperfusion, vasopressors, source control",
      "citation": "Evans L, Rhodes A, Alhazzani W, et al. Surviving Sepsis Campaign: international guidelines for management of sepsis and septic shock 2021. Crit Care Med. 2021;49:e1063–e1143.",
      "verified": false
    }
  ],
  "rationale": "Permutation: severity/delay. Tests the sepsis bundle (cultures, antibiotics, fluids/vasopressors), shock alarms and emergency source control.",
