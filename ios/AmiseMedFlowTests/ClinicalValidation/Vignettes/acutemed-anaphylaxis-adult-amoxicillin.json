  "guideline": [
    {
      "id": "rcuk-anaphylaxis-2021",
      "verified": false,
      "name": "Resuscitation Council UK - Emergency treatment of anaphylaxis: guidelines for healthcare providers",
      "year": 2021,
      "section": "IM adrenaline (1 mg/mL) is the first-line treatment: adult and child >12 years 500 micrograms, child 6-12 years 300 micrograms, 6 months-6 years 150 micrograms; repeat after 5 minutes if no improvement; refractory anaphylaxis (no improvement after two IM doses) -> adrenaline infusion with critical care; antihistamines are not first-line and corticosteroids are no longer advised routinely; IV fluid bolus for shock",
      "citation": "Resuscitation Council UK. Emergency treatment of anaphylaxis: guidelines for healthcare providers. London: RCUK; May 2021."
    }
  ],
  "rationale": "Base anaphylaxis case, caused by our own prescription. The web shock prompt reads hypotension without fever as haemorrhagic/cardiogenic/obstructive shock; distributive (anaphylactic) shock is the test.",
