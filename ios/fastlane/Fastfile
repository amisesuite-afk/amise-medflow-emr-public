default_platform(:ios)

APP_ID        = "com.amise.medflow"
SCHEME        = "AmiseMedFlow"
PROJECT       = "AmiseMedFlow.xcodeproj"
XCCONFIG_PATH = File.expand_path("../Configuration.xcconfig", __dir__)

# ── Helper: write Configuration.xcconfig from env vars in CI ──────────────
def ensure_xcconfig
  return if File.exist?(XCCONFIG_PATH) && !ENV["CI"]

  team_id = ENV["DEVELOPER_TEAM_ID"] || ""
  supa_url = ENV["SUPABASE_URL"] || ""
  supa_key = ENV["SUPABASE_ANON_KEY"] || ""

  File.write(XCCONFIG_PATH, <<~XCCONFIG)
    // Auto-generated by fastlane in CI — do not commit
    DEVELOPMENT_TEAM = #{team_id}
    SUPABASE_URL = #{supa_url}
    SUPABASE_ANON_KEY = #{supa_key}
  XCCONFIG
  UI.message "✅ Configuration.xcconfig written for CI"
end

# ── App Store Connect API key (no 2FA — required for CI) ──────────────────
def connect_api_key
  app_store_connect_api_key(
    key_id:                  ENV["APP_STORE_API_KEY_ID"],
    issuer_id:               ENV["APP_STORE_API_ISSUER_ID"],
    key_content:             ENV["APP_STORE_API_KEY_CONTENT"],
    is_key_content_base64:   true,
    duration:                1200,
    in_house:                false
  )
end

platform :ios do

  # ────────────────────────────────────────────────────────────────────────
  # lane :beta — build Release and upload to TestFlight
  # Run locally:  bundle exec fastlane beta
  # Run in CI:    triggered automatically by GitHub Actions on push to main
  # ────────────────────────────────────────────────────────────────────────
  lane :beta do
    ensure_xcconfig

    api_key = connect_api_key

    # Sync code-signing certificates + provisioning profiles.
    # On first run: `bundle exec fastlane match appstore` (creates the certs repo).
    # In CI:        readonly:true — never regenerate, just download.
    match(
      api_key:        api_key,
      type:           "appstore",
      app_identifier: APP_ID,
      team_id:        ENV["DEVELOPER_TEAM_ID"],
      git_url:        ENV["MATCH_GIT_URL"],
      readonly:       is_ci
    )

    # fastlane sh runs from ios/fastlane/ — use absolute paths throughout
    # so xcodebuild finds the project and the archive lands where upload expects it.
    team_id      = ENV["DEVELOPER_TEAM_ID"]
    ios_dir      = File.expand_path("..", __dir__)  # → .../ios
    archive_path = "#{ios_dir}/build/AmiseMedFlow.xcarchive"
    export_dir   = "#{ios_dir}/build/export"

    # CODE_SIGN_IDENTITY and PROVISIONING_PROFILE_SPECIFIER are set in
    # project.yml under configs.Release so they apply only to the app
    # target, not to SPM package dependencies (swift-crypto etc.) which
    # error when a provisioning profile is set on them.
    sh "xcodebuild " \
       "-scheme #{SCHEME} " \
       "-project '#{ios_dir}/#{PROJECT}' " \
       "-configuration Release " \
       "-sdk iphoneos " \
       "-destination 'generic/platform=iOS' " \
       "-archivePath '#{archive_path}' " \
       "DEVELOPMENT_TEAM='#{team_id}' " \
       "archive"

    # Write export plist at runtime so team ID and profile name are always correct.
    export_plist = "#{ios_dir}/ExportOptions-TestFlight.plist"
    File.write(export_plist, <<~PLIST)
      <?xml version="1.0" encoding="UTF-8"?>
      <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
      <plist version="1.0">
      <dict>
          <key>method</key>
          <string>app-store</string>
          <key>teamID</key>
          <string>#{team_id}</string>
          <key>signingStyle</key>
          <string>manual</string>
          <key>provisioningProfiles</key>
          <dict>
              <key>#{APP_ID}</key>
              <string>match AppStore #{APP_ID}</string>
          </dict>
          <key>stripSwiftSymbols</key>
          <true/>
          <key>uploadBitcode</key>
          <false/>
          <key>uploadSymbols</key>
          <true/>
      </dict>
      </plist>
    PLIST

    sh "xcodebuild " \
       "-exportArchive " \
       "-archivePath '#{archive_path}' " \
       "-exportPath '#{export_dir}' " \
       "-exportOptionsPlist '#{export_plist}'"

    # Upload to TestFlight.
    # skip_waiting_for_build_processing: CI doesn't wait — builds appear
    # in TestFlight within ~10–20 min after the job finishes.
    upload_to_testflight(
      api_key:                           api_key,
      app_identifier:                    APP_ID,
      ipa:                               "#{export_dir}/AmiseMedFlow.ipa",
      skip_waiting_for_build_processing: true,
      distribute_external:               false
    )

    UI.success "🚀 Uploaded to TestFlight — check App Store Connect in ~15 min"
  end

  # ────────────────────────────────────────────────────────────────────────
  # lane :setup_match — one-time: create the certs/profiles git repo
  # Run once on your Mac: bundle exec fastlane setup_match
  # ────────────────────────────────────────────────────────────────────────
  lane :setup_match do
    api_key = connect_api_key
    match(
      api_key:        api_key,
      type:           "appstore",
      app_identifier: APP_ID,
      team_id:        ENV["DEVELOPER_TEAM_ID"],
      git_url:        ENV["MATCH_GIT_URL"],
      readonly:       false,
      force_for_new_devices: true
    )
    UI.success "✅ Certificates and profiles created and stored in match repo"
  end

  # ────────────────────────────────────────────────────────────────────────
  # lane :add_device — register a new device for Ad Hoc / development builds
  # Run on your Mac: bundle exec fastlane add_device
  # ────────────────────────────────────────────────────────────────────────
  lane :add_device do
    api_key = connect_api_key
    device_name = UI.input("Device name (e.g. 'Dr Dawit iPhone 15 Pro'): ")
    udid        = UI.input("UDID (Settings → General → About → scroll to bottom): ")

    register_devices(
      api_key: api_key,
      devices: { device_name => udid }
    )
    match(
      api_key:               api_key,
      type:                  "development",
      app_identifier:        APP_ID,
      team_id:               ENV["DEVELOPER_TEAM_ID"],
      git_url:               ENV["MATCH_GIT_URL"],
      force_for_new_devices: true
    )
    UI.success "✅ Device registered and development profile updated"
  end

  # ────────────────────────────────────────────────────────────────────────
  # lane :bump — increment build number and commit (run before pushing)
  # ────────────────────────────────────────────────────────────────────────
  lane :bump do
    build = increment_build_number(xcodeproj: PROJECT)
    commit_version_bump(
      message:    "chore(ios): bump build to #{build}",
      xcodeproj:  PROJECT,
      force:      true
    )
    UI.success "✅ Build number → #{build}"
  end
end
