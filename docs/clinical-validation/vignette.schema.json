{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amise-medflow.local/clinical-validation/vignette.schema.json",
  "title": "Clinical validation vignette",
  "description": "A guideline-referenced clinical presentation run through the consultation engines on iOS and web. One file per vignette in ios/AmiseMedFlowTests/ClinicalValidation/Vignettes/<id>.json. See docs/clinical-validation/README.md for the grading rules.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "condition", "category", "permutationOf", "inputs", "expected", "guideline", "rationale"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Unique kebab-case id; must equal the file name without .json."
    },
    "condition": { "type": "string", "minLength": 3, "description": "The index condition, e.g. 'Acute appendicitis'." },
    "category": {
      "type": "string",
      "enum": ["hpb", "gi-emergency", "colorectal", "upper-gi", "hernia", "breast-endocrine", "trauma-burns", "soft-tissue", "vascular", "anorectal", "urology", "general-medicine", "other"]
    },
    "permutationOf": {
      "type": ["string", "null"],
      "description": "Id of the base case this vignette permutes; null for a base case."
    },
    "permutationLabel": { "type": "string", "description": "Short label, e.g. 'Elderly, atypical'." },
    "summary": { "type": "string", "description": "One or two sentences for the report." },
    "tags": { "type": "array", "items": { "type": "string" } },
    "inputs": { "$ref": "#/$defs/inputs" },
    "expected": { "$ref": "#/$defs/expected" },
    "guideline": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/guidelineRef" }
    },
    "rationale": { "type": "string", "minLength": 10 },
    "authoring": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "author": { "type": "string" },
        "reviewedBy": { "type": "string", "description": "Surgeon who signed off the expectations." },
        "date": { "type": "string" },
        "notes": { "type": "string" }
      }
    }
  },
  "$defs": {
    "platform": { "type": "string", "enum": ["ios", "web"] },
    "platformFlag": {
      "description": "true = every platform; an array = only those platforms.",
      "oneOf": [
        { "type": "boolean" },
        { "type": "array", "items": { "$ref": "#/$defs/platform" }, "uniqueItems": true }
      ]
    },
    "level": { "type": "string", "enum": ["routine", "priority", "urgent", "emergency"] },
    "scoreKey": {
      "type": "string",
      "description": "Canonical score key. Known: alvarado, air, ripasa, pas, tg18-cholecystitis, tg18-cholangitis, qsofa, sirs, sofa, news2, mews, bisap, ranson, glasgow-imrie, glasgow-blatchford, rockall, aims65, hinchey, asa, rcri, caprini, lrinec, wells-dvt, wells-pe, curb65, cfs, child-pugh, meld, asge-cbd. Platform-only keys are prefixed 'ios:' or 'web:'.",
      "pattern": "^([a-z0-9]+(-[a-z0-9]+)*|(ios|web):[A-Za-z0-9]+)$"
    },
    "matcher": {
      "type": "array",
      "minItems": 1,
      "description": "Alternatives; an item matches when ANY alternative matches. Plain text = case-insensitive substring after normalisation. 're:<pattern>' = case-insensitive regular expression (keep to the JS/ICU common subset). 'icd:<prefix>' = ICD-10 code starts with prefix (differential items only).",
      "items": { "type": "string", "minLength": 1 }
    },
    "expectationBase": {
      "type": "object",
      "required": ["id", "severity"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "description": "Unique within the vignette." },
        "severity": {
          "type": "string",
          "enum": ["critical", "quality"],
          "description": "critical = patient safety: an unflagged failure fails the test run. quality = reported only."
        },
        "platforms": {
          "type": "array",
          "items": { "$ref": "#/$defs/platform" },
          "uniqueItems": true,
          "description": "Platforms the expectation applies to. Default: both (pathway: ios only; dxVariant: web only)."
        },
        "knownGap": { "$ref": "#/$defs/platformFlag", "description": "Observed failure recorded as a known gap: reported, never fails the run." },
        "knownGapNote": { "type": "string" },
        "unverified": { "$ref": "#/$defs/platformFlag", "description": "Outcome on this platform not yet observed (e.g. iOS before the first CI run): reported, never fails the run. Remove once the baseline is known." },
        "guidelineRefs": { "type": "array", "items": { "type": "string" }, "description": "Ids from the vignette's guideline[]." },
        "note": { "type": "string", "description": "Why this expectation; uncertainty; what 'quality' means here." },
        "proposedFix": { "type": "string", "description": "Filled by the vignette author after triage; shown in REPORT.md." }
      }
    },
    "dxExpectation": {
      "allOf": [
        { "$ref": "#/$defs/expectationBase" },
        {
          "type": "object",
          "required": ["match"],
          "properties": {
            "match": { "$ref": "#/$defs/matcher" },
            "unless": { "$ref": "#/$defs/matcher" },
            "k": { "type": "integer", "minimum": 1, "description": "Rank limit. mustRankTopK: required. mustNotMiss: default = whole displayed list." },
            "source": { "type": "string", "description": "Differential source; default ios.bayes / web.pane. Others: ios.ccEarly, ios.pipeline, ios.triage, web.symptomInference, web.passive, web.triageSurgical." }
          }
        }
      ]
    },
    "textExpectation": {
      "allOf": [
        { "$ref": "#/$defs/expectationBase" },
        {
          "type": "object",
          "required": ["match"],
          "properties": {
            "match": { "$ref": "#/$defs/matcher" },
            "unless": { "$ref": "#/$defs/matcher", "description": "An item that also matches one of these does not count (e.g. 'avoid NSAIDs')." },
            "sources": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Restrict to output sources whose name starts with one of these (e.g. 'web.plan'). Default: every source of that kind."
            }
          }
        }
      ]
    },
    "scoreRecommendedExpectation": {
      "allOf": [
        { "$ref": "#/$defs/expectationBase" },
        { "type": "object", "required": ["score"], "properties": { "score": { "$ref": "#/$defs/scoreKey" } } }
      ]
    },
    "scoreValueExpectation": {
      "allOf": [
        { "$ref": "#/$defs/expectationBase" },
        {
          "type": "object",
          "required": ["score", "mode"],
          "properties": {
            "score": { "$ref": "#/$defs/scoreKey" },
            "mode": {
              "type": "string",
              "enum": ["calculator", "autofill"],
              "description": "calculator = the engine's calculator run on inputs.scoreForms[score] (clinician-completed form). autofill = what the app fills in from the record before the clinician touches the form. TG18 grades: 0 = criteria not met, 1–3 = Grade I–III."
            },
            "equals": { "type": "number" },
            "min": { "type": "number" },
            "max": { "type": "number" }
          }
        }
      ]
    },
    "levelExpectation": {
      "allOf": [
        { "$ref": "#/$defs/expectationBase" },
        {
          "type": "object",
          "properties": {
            "atLeast": { "$ref": "#/$defs/level" },
            "atMost": { "$ref": "#/$defs/level" }
          }
        }
      ]
    },
    "equalsExpectation": {
      "allOf": [
        { "$ref": "#/$defs/expectationBase" },
        { "type": "object", "required": ["equals"], "properties": { "equals": { "type": "string" } } }
      ]
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "differential": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mustRankTopK": { "type": "array", "items": { "$ref": "#/$defs/dxExpectation" } },
            "mustNotMiss": { "type": "array", "items": { "$ref": "#/$defs/dxExpectation" } }
          }
        },
        "safety": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "emergencyLevel": { "$ref": "#/$defs/levelExpectation" },
            "mustAlarm": { "type": "array", "items": { "$ref": "#/$defs/textExpectation" } },
            "mustNotAlarm": { "type": "array", "items": { "$ref": "#/$defs/textExpectation" } },
            "redFlags": { "type": "array", "items": { "$ref": "#/$defs/textExpectation" } }
          }
        },
        "scores": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "recommended": { "type": "array", "items": { "$ref": "#/$defs/scoreRecommendedExpectation" } },
            "values": { "type": "array", "items": { "$ref": "#/$defs/scoreValueExpectation" } }
          }
        },
        "investigations": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mustInclude": { "type": "array", "items": { "$ref": "#/$defs/textExpectation" } },
            "mustExclude": { "type": "array", "items": { "$ref": "#/$defs/textExpectation" } }
          }
        },
        "management": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mustInclude": { "type": "array", "items": { "$ref": "#/$defs/textExpectation" } },
            "mustExclude": { "type": "array", "items": { "$ref": "#/$defs/textExpectation" } }
          }
        },
        "pathway": { "$ref": "#/$defs/equalsExpectation", "description": "iOS ConsultPathway raw value (firstVisit, followUp, wardReview, procedure, trauma, burns, wellness)." },
        "dxVariant": { "$ref": "#/$defs/equalsExpectation", "description": "Web dx-variants.ts variant id detected for the confirmed diagnosis." }
      }
    },
    "guidelineRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "year", "section"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "description": "e.g. 'WSES Jerusalem guidelines — acute appendicitis (2020 update)'." },
        "year": { "type": "integer", "minimum": 1980 },
        "section": { "type": "string", "description": "Section / statement / recommendation." },
        "citation": { "type": "string", "description": "Full reference." },
        "verified": { "type": "boolean", "description": "true once statement numbering and wording have been checked against the source document." }
      }
    },
    "vitals": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minutesAgo": { "type": "integer", "minimum": 0, "description": "Recorded this many minutes before the consultation (default 0)." },
        "heartRate": { "type": "integer" },
        "systolicBp": { "type": "integer" },
        "diastolicBp": { "type": "integer" },
        "respiratoryRate": { "type": "integer" },
        "temperatureC": { "type": "number" },
        "spo2": { "type": "integer" },
        "avpu": { "type": "string", "enum": ["A", "C", "V", "P", "U"] },
        "onSupplementalO2": { "type": "boolean" },
        "glucoseMmol": { "type": "number" },
        "weightKg": { "type": "number" }
      }
    },
    "lab": {
      "type": "object",
      "additionalProperties": false,
      "required": ["analyte", "name"],
      "properties": {
        "analyte": {
          "type": "string",
          "description": "Canonical analyte key: wbc, neutrophilPct, haemoglobin, platelets, crp, sodium, potassium, urea, creatinine, bilirubin, alp, ggt, alt, ast, albumin, inr, lactate, amylase, lipase, glucose, urinalysis, bhcg, … Units: wbc/platelets ×10⁹/L, haemoglobin g/dL, crp mg/L, urea mmol/L, creatinine µmol/L, bilirubin µmol/L, albumin g/L, lactate mmol/L, enzymes U/L."
        },
        "name": { "type": "string", "description": "Name as it would be saved on the record (iOS: LabAnalyteCatalog saved name, e.g. 'WBC', 'Bilirubin')." },
        "value": { "type": "number" },
        "unit": { "type": "string" },
        "resultText": { "type": "string", "description": "Free-text result when there is no single number (e.g. urine dipstick)." },
        "minutesAgo": { "type": "integer", "minimum": 0 }
      }
    },
    "imaging": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "modality", "result"],
      "properties": {
        "name": { "type": "string", "description": "e.g. 'USS abdomen'." },
        "modality": { "type": "string", "enum": ["US", "CT", "MRI", "XR", "Endoscopy", "Other"] },
        "region": { "type": "string" },
        "result": { "type": "string" },
        "minutesAgo": { "type": "integer", "minimum": 0 }
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["patient", "encounter", "chiefComplaint", "hpi"],
      "properties": {
        "patient": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ageYears", "sex"],
          "properties": {
            "ageYears": { "type": "integer", "minimum": 0, "maximum": 120 },
            "sex": { "type": "string", "enum": ["male", "female", "unspecified"] },
            "pregnancy": {
              "type": "object",
              "additionalProperties": false,
              "required": ["status"],
              "properties": {
                "status": { "type": "string", "enum": ["not-applicable", "not-pregnant", "pregnant", "unknown"] },
                "gestationWeeks": { "type": "integer", "minimum": 1, "maximum": 44 }
              }
            },
            "heightCm": { "type": "number" },
            "weightKg": { "type": "number" }
          }
        },
        "encounter": {
          "type": "object",
          "additionalProperties": false,
          "required": ["setting"],
          "properties": {
            "setting": { "type": "string", "enum": ["outpatient", "inpatient", "emergency", "theatre", "endoscopy"] },
            "visitType": { "type": "string", "description": "iOS VisitType case name: newConsult, followUp, postOp, dayOfSurgery, ercp, ogd, colonoscopy, urgentReview, telephone, trauma, surgeryElective, surgeryEmergency, bronchoscopy, wardReview, burns, wellness." },
            "acuity": { "$ref": "#/$defs/level", "description": "Acuity recorded at booking/triage before the consultation." },
            "isPostOp": { "type": "boolean" },
            "postOpDays": { "type": "integer" }
          }
        },
        "chiefComplaint": { "type": "string", "description": "Presentation, never the diagnosis (the test would be circular)." },
        "hpi": { "type": "string" },
        "socrates": {
          "type": "object",
          "additionalProperties": false,
          "description": "Chip selections using the iOS SOCRATES chip labels (ConsultationViewSOCRATES.swift).",
          "properties": {
            "onset": { "type": "array", "items": { "type": "string" } },
            "site": { "type": "array", "items": { "type": "string" } },
            "character": { "type": "array", "items": { "type": "string" } },
            "radiation": { "type": "array", "items": { "type": "string" } },
            "associations": { "type": "array", "items": { "type": "string" } },
            "timing": { "type": "array", "items": { "type": "string" } },
            "exacerbating": { "type": "array", "items": { "type": "string" } },
            "relieving": { "type": "array", "items": { "type": "string" } },
            "severity": { "type": "array", "items": { "type": "string" } }
          }
        },
        "symptoms": { "type": "array", "items": { "type": "string" }, "description": "Canonical plain-English positive symptoms." },
        "negatives": { "type": "array", "items": { "type": "string" }, "description": "Pertinent negatives (documentation; engines mostly do not read them)." },
        "exam": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "general": { "type": "string" },
            "abdomen": { "type": "string" },
            "cardiovascular": { "type": "string" },
            "respiratory": { "type": "string" },
            "neuro": { "type": "string" },
            "msk": { "type": "string" },
            "skin": { "type": "string" },
            "other": { "type": "string" }
          }
        },
        "vitals": { "type": "array", "items": { "$ref": "#/$defs/vitals" }, "description": "Most recent last or first — ordered by minutesAgo." },
        "labs": { "type": "array", "items": { "$ref": "#/$defs/lab" } },
        "imaging": { "type": "array", "items": { "$ref": "#/$defs/imaging" } },
        "comorbidities": { "type": "array", "items": { "type": "string" } },
        "surgicalHistory": { "type": "array", "items": { "type": "string" } },
        "medications": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["drug"],
            "properties": {
              "drug": { "type": "string" },
              "dose": { "type": "string" },
              "frequency": { "type": "string" },
              "indication": { "type": "string" }
            }
          }
        },
        "allergies": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "severity"],
            "properties": {
              "name": { "type": "string" },
              "severity": { "type": "string", "enum": ["Mild", "Moderate", "Severe"] },
              "reaction": { "type": "string" }
            }
          }
        },
        "nkda": { "type": "boolean", "description": "No known drug allergies explicitly recorded." },
        "socialHistory": { "type": "string" },
        "scoreForms": {
          "type": "object",
          "description": "Clinician-completed score forms keyed by canonical score key, using the canonical field names in the README (e.g. alvarado.migration, tg18-cholangitis.feverAtLeast39, organDysfunction: ['renal']).",
          "additionalProperties": { "type": "object" }
        },
        "confirmedDiagnosis": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name"],
          "description": "The diagnosis the surgeon confirms on the Diagnosis tab; drives the plan, radiation, score mapper and web protocol. Kept separate so a differential failure does not hide plan checks.",
          "properties": {
            "name": { "type": "string" },
            "icd10": { "type": "string" },
            "paneDiseaseId": { "type": "string", "description": "lib/pane-engine disease id (web)." },
            "assessmentText": { "type": "string", "description": "What the surgeon types in Assessment (web dx-variant detection reads it)." }
          }
        },
        "platform": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ios": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "socratesSelections": { "type": "object", "additionalProperties": { "type": "array", "items": { "type": "string" } } },
                "specialtyHint": { "type": "string" }
              }
            },
            "web": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "ccTemplate": { "type": "string", "description": "cc-matrices template the clinician picks — a presentation, not a diagnosis." },
                "socratesAnswers": { "type": "object", "additionalProperties": { "type": "string" } },
                "symptoms": { "type": "array", "items": { "type": "string" }, "description": "SmartSymptomPicker chips (data/symptoms-db.ts)." },
                "symptomDetails": { "type": "object", "additionalProperties": { "type": "array", "items": { "type": "string" } }, "description": "SYMPTOM_BRANCHES option labels per symptom." },
                "examFindings": { "type": "object", "additionalProperties": { "type": "array", "items": { "type": "string" } }, "description": "ExaminationTab chips per system." },
                "paneAnswers": { "type": "object", "additionalProperties": { "type": "boolean" }, "description": "PANE Q&A answers (feature id → present)." },
                "toxicHabits": { "type": "array", "items": { "type": "string" } },
                "durationDays": { "type": "number" },
                "painScore": { "type": "number" }
              }
            }
          }
        }
      }
    }
  }
}
