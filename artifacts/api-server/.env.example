# ── Amise API Server — local development env ─────────────────────────────────
# Copy this file to .env and fill in your values.
# .env is git-ignored and NEVER committed.

PORT=8080
NODE_ENV=development

# Keep dry_run locally — never switch to auto without reviewing drafted messages
MODE=dry_run
SMS_PROVIDER=dry_run

SESSION_SECRET=change-me-in-production

# Supabase — get from: supabase.com/dashboard/project/nornhfzfrlmfzaqmrzzp/settings/api
SUPABASE_URL=https://nornhfzfrlmfzaqmrzzp.supabase.co
SUPABASE_SERVICE_ROLE_KEY=         # service role key — never expose to browser

# Patient portal
PORTAL_URL=http://localhost:3000/patient

# Anthropic — get from: console.anthropic.com/account/keys
ANTHROPIC_API_KEY=sk-ant-...

# Google OAuth — for Gmail + Calendar
GMAIL_USER=amisesuite@gmail.com
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# Calendar IDs
CALENDAR_ID_RODNEY_BAY=amisesuite@gmail.com
CALENDAR_ID_CASTRIES=amisesuite@gmail.com
CALENDAR_ID_TAPION_ERCP=amisesuite@gmail.com

# Twilio (optional — only needed if SMS_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Notifications
DOCTOR_NOTIFY_EMAIL=
STAFF_NOTIFY_EMAIL=
STAFF_NOTIFY_PHONE=
PRACTICE_PHONE=+17582840557
CRON_SECRET=

# CORS — set these to your production URLs
PORTAL_URL=http://localhost:3000
DASHBOARD_URL=http://localhost:5173

# Error monitoring (optional)
SENTRY_DSN=

# AI model override (optional — default claude-haiku-4-5-20251001)
# CLAUDE_MODEL=claude-haiku-4-5-20251001
