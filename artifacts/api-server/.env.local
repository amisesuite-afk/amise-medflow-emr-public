# ── Google Calendar ────────────────────────────────────────────────────────────
# Single calendar — all locations share amisesuite@gmail.com
GMAIL_USER=amisesuite@gmail.com
CALENDAR_ID_RODNEY_BAY=amisesuite@gmail.com
CALENDAR_ID_CASTRIES=amisesuite@gmail.com
CALENDAR_ID_TAPION_ERCP=amisesuite@gmail.com

# GOOGLE_SERVICE_ACCOUNT_JSON is required for live calendar reads/writes.
# Without it the scheduling route falls back to rule-based mock slots.
# To enable: create a Google Cloud service account, grant it
# "Google Calendar API" access, enable domain-wide delegation for
# https://www.googleapis.com/auth/calendar, and paste the full JSON here.
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# ── Supabase (server-side) ─────────────────────────────────────────────────────
SUPABASE_URL=https://nornhfzfrlmfzaqmrzzp.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=sb_secret_...   ← reveal from Supabase → API Keys → Secret

# ── AI ─────────────────────────────────────────────────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-...

# ── Messaging (leave blank for dry-run) ────────────────────────────────────────
MODE=dry_run
SMS_PROVIDER=dry_run
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# ── Other ──────────────────────────────────────────────────────────────────────
SESSION_SECRET=local-dev-secret-change-in-production
# CRON_SECRET=
# DOCTOR_NOTIFY_EMAIL=
