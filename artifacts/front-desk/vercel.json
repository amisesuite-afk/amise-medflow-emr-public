{
  "framework": "nextjs",
  "ignoreCommand": "cd ../.. && git diff --quiet HEAD^ HEAD -- artifacts/front-desk lib/triage-engine pnpm-lock.yaml pnpm-workspace.yaml package.json",
  "installCommand": "npm install -g pnpm@10 && cd ../.. && pnpm install",
  "buildCommand": "cd ../.. && pnpm --filter {./artifacts/front-desk} run build",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ],
  "git": {
    "deploymentEnabled": true
  }
}
