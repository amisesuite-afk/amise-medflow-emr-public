# ── Amise MedFlow EMR — Environment Variables ────────────────────────────────
# Copy this file to .env.local and fill in all values before starting.
# Never commit .env.local to version control.
#
# Deployment platforms: Vercel (recommended), Railway, or any Node 20+ host.
# All variables marked PUBLIC are exposed to the browser.
# All others are server-side only.

# ── App ──────────────────────────────────────────────────────────────────────

# Controls outbound actions (email / SMS / calendar writes).
# Start with dry_run. Switch to supervised to require staff approval.
# Use auto only when thoroughly tested.
#   dry_run   — logs actions, sends nothing
#   supervised — drafts sent for staff approval before delivery
#   auto       — fully automated outbound (production)
MODE=dry_run

# Shared secret for internal webhook routes (POST /api/booking/urgent, etc.)
# Generate with: openssl rand -hex 32
WEBHOOK_SECRET=change-me-with-openssl-rand-hex-32

# Public URL of this app (used in staff alert links and emails)
NEXT_PUBLIC_DASHBOARD_URL=https://yourapp.vercel.app

# ── Supabase ──────────────────────────────────────────────────────────────────
# Create a project at https://supabase.com
# Run supabase-schema.sql in the SQL editor to create all tables and RLS.

# Project URL — found in: Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Anon key — MUST be the JWT format (starts with eyJ…), NOT sb_publishable_…
# Found in: Project Settings → API → Project API keys → anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service role key — server-side only, never expose to browser.
# Found in: Project Settings → API → Project API keys → service_role
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Google (Calendar + Gmail) ─────────────────────────────────────────────────
# Option A — Service account (recommended for production)
# 1. Create a service account in Google Cloud Console → IAM & Admin
# 2. Enable Calendar API and Gmail API for the project
# 3. Grant domain-wide delegation with scopes:
#      https://www.googleapis.com/auth/calendar
#      https://www.googleapis.com/auth/gmail.send
# 4. Download the JSON key and paste the entire contents (one line) below.
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n","client_email":"amise@project.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}

# Gmail address the service account impersonates (must have domain-wide delegation)
GMAIL_USER=info@amisemedical.com

# Option B — OAuth2 (simpler for personal accounts, less reliable for servers)
# Uncomment these if using OAuth2 instead of a service account.
# GOOGLE_OAUTH_CLIENT_ID=xxxx.apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-xxxx
# GOOGLE_OAUTH_REFRESH_TOKEN=1//xxxx

# Google Calendar IDs — found in Calendar Settings → Integrate calendar → Calendar ID
CALENDAR_ID_RODNEY_BAY=your-rodney-bay-calendar@group.calendar.google.com
CALENDAR_ID_CASTRIES=your-castries-calendar@group.calendar.google.com
CALENDAR_ID_TAPION_ERCP=your-tapion-ercp-calendar@group.calendar.google.com

# ── Twilio (SMS + WhatsApp) ───────────────────────────────────────────────────
# Sign up at https://twilio.com
# For WhatsApp: enrol a number in the WhatsApp Business API sandbox first,
# then apply for a production sender.

# Account SID — found on Twilio Console dashboard
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Auth token — found on Twilio Console dashboard (keep secret)
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Your Twilio sender number. Prefix with whatsapp: for WhatsApp channel.
#   WhatsApp: whatsapp:+17582840557
#   SMS:      +17582840557
TWILIO_FROM_NUMBER=whatsapp:+17582840557

# WhatsApp number to alert nursing staff on new urgent/referral bookings.
# Must be registered on WhatsApp and approved as a recipient in the Twilio sandbox.
NURSE_ALERT_WHATSAPP=whatsapp:+17582840557

# ── Anthropic (Claude AI) ─────────────────────────────────────────────────────
# Create an API key at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-api03-xxxx

# ── Email notifications ───────────────────────────────────────────────────────
# Email address for doctor escalations and daily summaries
DOCTOR_NOTIFY_EMAIL=dr.kabiye@amisemedical.com

# ── Deployment checklist ──────────────────────────────────────────────────────
# Before going live, confirm:
#   [ ] Supabase schema applied (supabase-schema.sql)
#   [ ] RLS policies verified — patients cannot read other patients' data
#   [ ] Google service account has Calendar + Gmail scopes
#   [ ] Twilio WhatsApp sender approved for production (not sandbox)
#   [ ] WEBHOOK_SECRET rotated from default
#   [ ] MODE set to 'supervised' for first week, then review
#   [ ] Custom domain configured on Vercel (amisemedicalservices.com)
#   [ ] HTTPS enforced (automatic on Vercel)
#   [ ] Test booking end-to-end in supervised mode before switching to auto
