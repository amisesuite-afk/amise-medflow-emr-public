# ── Amise Front Desk — local development env ─────────────────────────────────
# Copy this file to .env.local and fill in your values.
# .env.local is git-ignored and NEVER committed.

# Supabase — get from: supabase.com/dashboard/project/nornhfzfrlmfzaqmrzzp/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://nornhfzfrlmfzaqmrzzp.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im5vcm5oZnpmcmxtZnphcW1yenpwIiwicm9sZSI6ImFub24iLCJpYXQiOjE3Nzg5OTU5NjcsImV4cCI6MjA5NDU3MTk2N30.IQqwEuwp4_CYRj5r6H-83vjXKeob-N8z5TBwLk-rXLc

# Site URL — used for magic link email redirects.
# For local dev use http://localhost:3000
# For production: https://front-desk-amisesuite-afks-projects.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# api-server origin — for privileged server-to-server calls (e.g. minting
# pre-consult questionnaire links). Defaults to the production API if unset.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Machine secret sent as `x-staff-token` for privileged calls to the
# api-server (e.g. POST /api/questionnaire/provision-link). Must match the
# api-server's STAFF_MACHINE_TOKEN exactly; set both together. Without it,
# questionnaire links are silently omitted from confirmation messages
# (booking still succeeds).
STAFF_MACHINE_TOKEN=

# Legacy fallback: used for `x-staff-token` only while STAFF_MACHINE_TOKEN is
# unset (must then match the api-server's CRON_SECRET). Remove once
# STAFF_MACHINE_TOKEN is set on both sides.
CRON_SECRET=

# URL of the staff triage dashboard (artifacts/dashboard), included in
# WhatsApp/SMS alerts to staff ("Review dashboard: ..."). If unset, that
# line is omitted from alerts — set this once the dashboard is deployed.
NEXT_PUBLIC_DASHBOARD_URL=

# Outbound gate for SMS, WhatsApp and email sent by this app (lib/outbound.ts):
# dry_run (default) | supervised | auto. Any other value — including unset or
# a typo — is treated as dry_run and nothing is sent.
MODE=dry_run

# Staff pages: idle auto sign-out in minutes (default 15, clamped 2–120).
# Inlined at build time — redeploy after changing it.
# NEXT_PUBLIC_IDLE_TIMEOUT_MINUTES=15
