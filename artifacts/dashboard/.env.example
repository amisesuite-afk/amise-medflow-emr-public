# Amise MedFlow Dashboard — environment variables
# Copy to .env.local and fill in your values.
# .env.local is git-ignored and NEVER committed.

# Supabase project URL (e.g. https://abcdefgh.supabase.co)
VITE_SUPABASE_URL=

# Supabase anon/public JWT key (starts with eyJ, ~200+ chars).
# NOT the opaque sb_publishable_ format — supabase-js v2 rejects it.
# Find it at: Supabase Dashboard > Settings > API > anon public
VITE_SUPABASE_ANON_KEY=
